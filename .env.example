DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SITE_URL=
# Read/write token from Vercel > Storage > your Blob store. Server-side only: never prefix with NEXT_PUBLIC_.
# Without it, Payload silently falls back to saving uploads in the local media directory.
BLOB_READ_WRITE_TOKEN=
